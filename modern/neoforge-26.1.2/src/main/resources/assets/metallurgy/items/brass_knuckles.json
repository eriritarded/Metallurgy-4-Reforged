{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "ground",
          "fixed"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "metallurgy:item/gadget/brass_knuckles_item"
        }
      },
      {
        "when": "firstperson_righthand",
        "model": {
          "type": "minecraft:special",
          "base": "metallurgy:item/gadget/brass_knuckles_hand",
          "model": {
            "type": "metallurgy:knuckles",
            "first_person": true,
            "left": false
          }
        }
      },
      {
        "when": "firstperson_lefthand",
        "model": {
          "type": "minecraft:special",
          "base": "metallurgy:item/gadget/brass_knuckles_hand",
          "model": {
            "type": "metallurgy:knuckles",
            "first_person": true,
            "left": true
          }
        }
      },
      {
        "when": "thirdperson_lefthand",
        "model": {
          "type": "minecraft:special",
          "base": "metallurgy:item/gadget/brass_knuckles_hand",
          "model": {
            "type": "metallurgy:knuckles",
            "first_person": false,
            "left": true
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:special",
      "base": "metallurgy:item/gadget/brass_knuckles_hand",
      "model": {
        "type": "metallurgy:knuckles",
        "first_person": false,
        "left": false
      }
    }
  }
}
